# ==========================================================
# SIGAP - Konfigurasi Lingkungan Produksi Docker & 1Panel
# Salin file ini menjadi .env sebelum menjalankan docker compose
# ==========================================================

APP_NAME="SIGAP - Sistem Informasi Gangguan & Analisis Performa"
APP_ENV=production
APP_KEY=base64:OEa3k7TNWkuFpZ4FDrZhnT4eYq+KwbAoYoIFxl4NZKI=
APP_DEBUG=false
APP_URL=http://localhost:8093
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Port Exposure (Akses Host / 1Panel)
# Catatan port host yang sudah aktif di server Anda:
# - wa-gateway-app : port 8081
# - 9router        : port 20128
# - OpenResty      : port 80 & 443
# Port SIGAP berikut diatur agar 100% aman dan tidak bentrok:
APP_PORT=8093
FORWARD_DB_PORT=3314
FORWARD_REDIS_PORT=6389

# Octane & FrankenPHP
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# Otomatis migrasi saat container app pertama kali menyala (true/false)
AUTO_MIGRATE=true

# Database MySQL (Sesuai container service 'db')
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_sigap
DB_USERNAME=sigap_user
DB_PASSWORD=sigap_secret_2026
DB_ROOT_PASSWORD=sigap_root_2026

# Redis (Sesuai container service 'redis')
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Driver Session, Cache, dan Queue
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Notification
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sigap.local"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi AI 9Router (Analisis Otomatis)
NINEROUTER_API_ENDPOINT=https://9router.humacode.my.id/v1
NINEROUTER_API_KEY=sk-bb945c3357223494-kwdegr-5454082f
NINEROUTER_MODEL=combo-maut

# Cloudflare Turnstile CAPTCHA Protection
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAFZ4WXavbkvzVgKB
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAFZ4WRWXyCsJLVG3fTzVpIUhMmc

